<% content_for :title, "Cost Breakdown - #{@trip.title}" %>

<div class="container">
  <div class="section-header">
    <div>
      <%= link_to "← Back to #{@trip.title}", trip_path(@trip), style: "font-size: 0.9rem; font-weight: 600; display: inline-block; margin-bottom: 0.5rem;" %>
      <h1 class="section-title">📊 Trip Cost Breakdown & Analytics</h1>
      <p class="section-subtitle">Financial distribution across transport, lodging, meals, and incidentals</p>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 320px 1fr; gap: 2rem; align-items: start;">
    <!-- Metric Sidebar -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div class="estimate-metric-box">
        <div class="estimate-metric-label">Total Estimated Cost</div>
        <div class="estimate-metric-number">$<%= number_with_precision(@trip.total_estimated_cost, precision: 2) %></div>
        <div style="font-size: 0.85rem; color: #1e40af;">
          $<%= number_with_precision((@trip.total_estimated_cost / @trip.number_of_travelers.to_f), precision: 2) %> per person
        </div>
      </div>

      <% if @trip.target_budget.present? && @trip.target_budget > 0 %>
        <div class="card" style="padding: 1.5rem;">
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.75rem;">🎯 Target Budget Tracking</h3>
          <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem;">
            <span>Target: <strong>$<%= @trip.target_budget %></strong></span>
            <span>Spent: <strong>$<%= @trip.total_estimated_cost %></strong></span>
          </div>

          <div style="height: 8px; background: #e2e8f0; border-radius: 999px; overflow: hidden; margin-bottom: 0.75rem;">
            <% pct = [((@trip.total_estimated_cost / @trip.target_budget) * 100).round, 100].min %>
            <div style="height: 100%; width: <%= pct %>%; background: <%= @trip.total_estimated_cost <= @trip.target_budget ? 'var(--success)' : 'var(--danger)' %>;"></div>
          </div>

          <div style="font-size: 0.85rem; color: <%= @trip.budget_variance >= 0 ? '#166534' : '#991b1b' %>;">
            <%= @trip.budget_variance >= 0 ? "Under budget by $#{number_with_precision(@trip.budget_variance, precision: 2)}" : "Over budget by $#{number_with_precision(@trip.budget_variance.abs, precision: 2)}" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Category Breakdown Cards -->
    <div class="card" style="padding: 2rem;">
      <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 1.5rem;">Category Allocations</h2>

      <table class="data-table" style="margin-bottom: 2rem;">
        <thead>
          <tr>
            <th>Expense Category</th>
            <th>Total Allocation</th>
            <th>% of Total</th>
            <th>Per Traveler</th>
          </tr>
        </thead>
        <tbody>
          <% @breakdown.each do |category, sum| %>
            <% pct = @trip.total_estimated_cost > 0 ? ((sum / @trip.total_estimated_cost) * 100).round(1) : 0 %>
            <tr>
              <td>
                <strong>
                  <% case category %>
                  <% when "hotel" then %>🏨 Accommodations & Lodging
                  <% when "transport" then %>🚗 Transportation & Fares
                  <% when "food" then %>🍽️ Food & Dining
                  <% when "toll_fuel" then %>⛽ Tolls, Transfers & Fuel
                  <% when "activity" then %>🎟️ Sightseeing & Activities
                  <% else %>📦 <%= category.capitalize %>
                  <% end %>
                </strong>
              </td>
              <td style="font-weight: 700; color: var(--primary);">$<%= number_with_precision(sum, precision: 2) %></td>
              <td><%= pct %>%</td>
              <td>$<%= number_with_precision((sum / @trip.number_of_travelers.to_f), precision: 2) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem;">All Items in Budget</h3>
      <table class="data-table">
        <thead>
          <tr>
            <th>Item</th>
            <th>Category</th>
            <th>Unit Cost</th>
            <th>Qty</th>
            <th>Total Cost</th>
          </tr>
        </thead>
        <tbody>
          <% @bookings.each do |b| %>
            <tr>
              <td><%= b.title %></td>
              <td><span class="badge badge-muted"><%= b.item_type.capitalize %></span></td>
              <td>$<%= b.unit_cost %></td>
              <td><%= b.quantity %></td>
              <td style="font-weight: 700;">$<%= number_with_precision(b.total_cost, precision: 2) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
