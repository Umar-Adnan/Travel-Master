<% content_for :title, "My Trips - TravelMaster" %>

<div class="container">
  <div class="section-header">
    <div>
      <h1 class="section-title">My Travel Plans & Itineraries</h1>
      <p class="section-subtitle">Manage all your upcoming vacations, business meetings, and group trips</p>
    </div>
    <%= link_to "+ Plan New Trip", new_trip_path, class: "btn btn-primary" %>
  </div>

  <% if @trips.any? %>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% @trips.each do |trip| %>
        <div class="card" style="padding: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <h2 style="font-size: 1.35rem; font-weight: 700;"><%= link_to trip.title, trip_path(trip) %></h2>
                <span class="badge badge-muted"><%= trip.trip_type %></span>
                <span class="badge badge-primary"><%= trip.status %></span>
              </div>
              <div style="font-size: 0.9rem; color: var(--text-muted); display: flex; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
                <span>📅 <%= trip.start_date.strftime("%B %d, %Y") %> – <%= trip.end_date.strftime("%B %d, %Y") %> (<strong><%= trip.duration_days %> days</strong>)</span>
                <span>👥 <%= trip.number_of_travelers %> <%= "traveler".pluralize(trip.number_of_travelers) %></span>
              </div>
              <div style="font-size: 0.9rem; color: #475569;">
                📍 <strong>Destinations:</strong> <%= trip.destinations.map(&:name).join(" ➔ ").presence || "None assigned yet" %>
              </div>
            </div>

            <div style="text-align: right;">
              <span style="font-size: 0.8rem; color: var(--text-muted);">Estimated Trip Total</span>
              <div style="font-size: 1.6rem; font-weight: 800; color: var(--primary);">
                $<%= number_with_precision(trip.total_estimated_cost, precision: 2) %>
              </div>
              <% if trip.target_budget.present? && trip.target_budget > 0 %>
                <div style="font-size: 0.8rem; color: <%= trip.budget_variance >= 0 ? '#166534' : '#991b1b' %>;">
                  Target: $<%= trip.target_budget %> (<%= trip.budget_status %>)
                </div>
              <% end %>
            </div>
          </div>

          <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
            <div style="display: flex; gap: 0.5rem;">
              <%= link_to "🗓️ Day-by-Day Itinerary", itinerary_trip_path(trip), class: "btn btn-secondary btn-sm" %>
              <%= link_to "📊 Cost Breakdown", cost_breakdown_trip_path(trip), class: "btn btn-secondary btn-sm" %>
              <%= link_to "🖨️ Export / Print", print_view_trip_path(trip), class: "btn btn-outline btn-sm", target: "_blank" %>
            </div>

            <div style="display: flex; gap: 0.5rem;">
              <%= link_to "Edit Details", edit_trip_path(trip), class: "btn btn-outline btn-sm" %>
              <%= button_to "Delete", trip_path(trip), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this trip?" }, class: "btn btn-danger btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card" style="padding: 4rem 2rem; text-align: center;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🗺️</div>
      <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">No trips created yet</h2>
      <p style="color: var(--text-muted); max-width: 500px; margin: 0 auto 1.5rem;">
        Start by creating your first trip, selecting destinations, and letting TravelMaster automatically estimate all expenses.
      </p>
      <%= link_to "+ Plan Your First Trip", new_trip_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>
