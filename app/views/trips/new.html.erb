<% content_for :title, "Plan a New Trip - TravelMaster" %>

<div class="container-sm">
  <div class="card" style="padding: 2.25rem;">
    <div style="margin-bottom: 2rem;">
      <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 0.4rem;">Plan a New Trip</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Select your destinations and travel parameters to generate an automated itinerary and budget</p>
    </div>

    <%= form_with model: @trip, local: true do |f| %>
      <% if @trip.errors.any? %>
        <div class="flash flash-alert" style="margin-bottom: 1.5rem;">
          <ul>
            <% @trip.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :title, "Trip Title", class: "form-label" %>
        <%= f.text_field :title, class: "form-control", placeholder: "e.g. Summer Vacation across Japan & Bali", required: true %>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :trip_type, "Trip Purpose / Type", class: "form-label" %>
          <%= f.select :trip_type, ["Personal", "Group Vacation", "Business Meeting", "Family Holiday", "Solo Exploration"], {}, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :number_of_travelers, "Number of Travelers", class: "form-label" %>
          <%= f.number_field :number_of_travelers, min: 1, max: 100, class: "form-control", required: true %>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :start_date, "Departure / Start Date", class: "form-label" %>
          <%= f.date_field :start_date, class: "form-control", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :end_date, "Return / End Date", class: "form-label" %>
          <%= f.date_field :end_date, class: "form-control", required: true %>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Select Destination(s) to Visit</label>
        <div style="max-height: 200px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem; background: white;">
          <% @destinations.each do |dest| %>
            <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0; font-size: 0.9rem; cursor: pointer;">
              <input type="checkbox" name="destination_ids[]" value="<%= dest.id %>" <%= "checked" if Array(params[:destination_ids]).map(&:to_s).include?(dest.id.to_s) %>>
              <span><strong><%= dest.name %></strong> (<%= dest.city %>, <%= dest.country %>) - $<%= dest.price %>/day</span>
            </label>
          <% end %>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :target_budget, "Target Budget (optional)", class: "form-label" %>
          <%= f.number_field :target_budget, step: "0.01", placeholder: "e.g. 2500.00", class: "form-control" %>
          <div class="form-help">Set a spending goal to monitor budget variances.</div>
        </div>

        <div class="form-group">
          <%= f.label :budget_currency, "Budget Currency", class: "form-label" %>
          <%= f.select :budget_currency, ["USD", "EUR", "GBP", "CAD", "AUD", "JPY", "PKR"], {}, class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :notes, "Trip Notes & Planning Objectives", class: "form-label" %>
        <%= f.text_area :notes, rows: 3, class: "form-control", placeholder: "e.g. Must visit Mount Fuji, dietary preferences, meeting scheduled on day 3..." %>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <%= f.submit "Generate Trip & Automated Budget", class: "btn btn-primary btn-lg" %>
        <%= link_to "Cancel", trips_path, class: "btn btn-secondary btn-lg" %>
      </div>
    <% end %>
  </div>
</div>
