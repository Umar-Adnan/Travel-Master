<% content_for :title, "Edit Trip - #{@trip.title}" %>

<div class="container-sm">
  <div class="card" style="padding: 2.25rem;">
    <div style="margin-bottom: 2rem;">
      <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 0.4rem;">Edit Trip Details</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Modify dates, status, or destinations for "<%= @trip.title %>"</p>
    </div>

    <%= form_with model: @trip, local: true do |f| %>
      <div class="form-group">
        <%= f.label :title, "Trip Title", class: "form-label" %>
        <%= f.text_field :title, class: "form-control", required: true %>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :trip_type, "Trip Type", class: "form-label" %>
          <%= f.select :trip_type, ["Personal", "Group Vacation", "Business Meeting", "Family Holiday", "Solo Exploration"], {}, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :status, "Trip Status", class: "form-label" %>
          <%= f.select :status, ["Draft", "Planned", "Booked", "Completed", "Cancelled"], {}, class: "form-control" %>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :start_date, "Departure Date", class: "form-label" %>
          <%= f.date_field :start_date, class: "form-control", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :end_date, "Return Date", class: "form-label" %>
          <%= f.date_field :end_date, class: "form-control", required: true %>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :number_of_travelers, "Number of Travelers", class: "form-label" %>
          <%= f.number_field :number_of_travelers, min: 1, class: "form-control", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :target_budget, "Target Budget ($)", class: "form-label" %>
          <%= f.number_field :target_budget, step: "0.01", class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Destinations in this Trip</label>
        <div style="max-height: 200px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem; background: white;">
          <% @destinations.each do |dest| %>
            <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0; font-size: 0.9rem; cursor: pointer;">
              <input type="checkbox" name="destination_ids[]" value="<%= dest.id %>" <%= "checked" if @trip.destination_ids.include?(dest.id) %>>
              <span><strong><%= dest.name %></strong> (<%= dest.city %>, <%= dest.country %>)</span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :notes, "Notes", class: "form-label" %>
        <%= f.text_area :notes, rows: 3, class: "form-control" %>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <%= f.submit "Save Changes", class: "btn btn-primary btn-lg" %>
        <%= link_to "Cancel", trip_path(@trip), class: "btn btn-secondary btn-lg" %>
      </div>
    <% end %>
  </div>
</div>
