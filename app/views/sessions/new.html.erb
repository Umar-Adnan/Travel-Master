<% content_for :title, "Log In - TravelMaster" %>

<div class="container-sm" style="margin-top: 3rem;">
  <div class="card" style="padding: 2rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem;">Welcome Back</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Log in to access your planned trips and custom budgets</p>
    </div>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email Address", class: "form-label" %>
        <%= f.email_field :email, class: "form-control", placeholder: "you@example.com", required: true, autofocus: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password", class: "form-label" %>
        <%= f.password_field :password, class: "form-control", placeholder: "••••••••", required: true %>
      </div>

      <div style="margin-top: 2rem;">
        <%= f.submit "Log In to TravelMaster", class: "btn btn-primary btn-lg", style: "width: 100%;" %>
      </div>
    <% end %>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem; color: var(--text-muted);">
      Don't have an account yet? <%= link_to "Create Account", signup_path, style: "font-weight: 600;" %>
    </div>

    <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px dashed var(--border-color); font-size: 0.85rem; color: #64748b; background: #f8fafc; padding: 1rem; border-radius: var(--radius-md);">
      <strong>Demo Accounts:</strong><br>
      • Admin: <code>admin@travelmaster.com</code> / <code>password123</code><br>
      • Traveler: <code>traveler@travelmaster.com</code> / <code>password123</code>
    </div>
  </div>
</div>
