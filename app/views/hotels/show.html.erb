<% content_for :title, "#{@hotel.name} - Hotel Overview" %>

<div class="container">
  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; align-items: start;">
    <div>
      <div class="card" style="overflow: hidden; margin-bottom: 2rem;">
        <div style="height: 320px; background: #0f172a;">
          <img src="<%= @hotel.image_url.presence || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1000&auto=format&fit=crop&q=80' %>" alt="<%= @hotel.name %>" style="width: 100%; height: 100%; object-fit: cover;">
        </div>

        <div style="padding: 2rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <h1 style="font-size: 1.8rem; font-weight: 800;"><%= @hotel.name %></h1>
            <span style="color: #f59e0b; font-size: 1.1rem;"><%= "★" * @hotel.star_rating %></span>
          </div>

          <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
            📍 <%= @hotel.address %> • <%= link_to @destination.name, destination_path(@destination) %>
          </p>

          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Overview</h3>
          <p style="color: #334155; line-height: 1.7; font-size: 0.95rem; margin-bottom: 1.5rem;">
            <%= @hotel.description %>
          </p>

          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.75rem;">Amenities & Features</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
            <% @hotel.amenities_list.each do |a| %>
              <span class="badge badge-primary">✓ <%= a %></span>
            <% end %>
          </div>

          <div style="font-size: 0.9rem; color: var(--text-muted); padding-top: 1rem; border-top: 1px solid var(--border-light);">
            Contact: <strong><%= @hotel.contact_number.presence || "+1 800 555-0199" %></strong> • Available Rooms: <strong><%= @hotel.available_rooms %></strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Booking / Add to Trip Box -->
    <div>
      <div class="card" style="padding: 2rem; background: white;">
        <div style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1rem;">
          <span style="font-size: 0.85rem; color: var(--text-muted);">Nightly Rate</span>
          <div style="font-size: 2rem; font-weight: 800; color: var(--primary);">
            $<%= @hotel.price_per_night %> <span style="font-size: 0.9rem; font-weight: normal; color: var(--text-muted);">/ night</span>
          </div>
          <span class="badge badge-success" style="margin-top: 0.25rem;">Free Cancellation available</span>
        </div>

        <% if logged_in? && @user_trips.any? %>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem;">Add to an Upcoming Trip</h3>

          <%= form_with url: add_to_trip_hotel_path(@hotel), method: :post, local: true do |f| %>
            <div class="form-group">
              <%= f.label :trip_id, "Select Your Trip", class: "form-label" %>
              <%= f.select :trip_id, @user_trips.map { |t| [t.title, t.id] }, {}, class: "form-control" %>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
              <div class="form-group">
                <%= f.label :nights, "Nights", class: "form-label" %>
                <%= f.number_field :nights, value: 3, min: 1, max: 30, class: "form-control" %>
              </div>

              <div class="form-group">
                <%= f.label :rooms, "Rooms", class: "form-label" %>
                <%= f.number_field :rooms, value: 1, min: 1, max: 10, class: "form-control" %>
              </div>
            </div>

            <div style="margin-top: 1.5rem;">
              <%= f.submit "🏨 Add Hotel to Itinerary", class: "btn btn-primary btn-lg", style: "width: 100%;" %>
            </div>
          <% end %>
        <% elsif logged_in? %>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">You don't have any upcoming trips yet.</p>
          <%= link_to "+ Create a Trip First", new_trip_path(destination_ids: [@destination.id]), class: "btn btn-primary", style: "width: 100%;" %>
        <% else %>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">Sign in to add this stay to your trip itinerary.</p>
          <%= link_to "Log In to Reserve", login_path, class: "btn btn-primary", style: "width: 100%;" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
