<% content_for :title, "Edit Profile - TravelMaster" %>

<div class="container-sm" style="margin-top: 2rem;">
  <div class="card" style="padding: 2rem;">
    <div style="margin-bottom: 1.5rem;">
      <h1 style="font-size: 1.6rem; font-weight: 700;">Edit Profile Preferences</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Tailor automatic cost estimations and travel recommendations to your style</p>
    </div>

    <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, "Full Name", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", required: true %>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <%= f.label :travel_preference, "Default Travel Budget Tier", class: "form-label" %>
          <%= f.select :travel_preference, [["Budget Conscious (Hostels, Public transit, Street food)", "budget"], ["Moderate (3-4 Star Hotels, Flights/Trains, Good dining)", "moderate"], ["Luxury (5 Star Resorts, First class, Premium tours)", "luxury"]], {}, class: "form-control" %>
          <div class="form-help">Used by the Cost Estimator service to calculate default budgets.</div>
        </div>

        <div class="form-group">
          <%= f.label :default_currency, "Preferred Currency", class: "form-label" %>
          <%= f.select :default_currency, ["USD", "EUR", "GBP", "CAD", "AUD", "JPY", "PKR"], {}, class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :phone_number, "Contact Phone", class: "form-label" %>
        <%= f.text_field :phone_number, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :bio, "Travel Bio / Notes", class: "form-label" %>
        <%= f.text_area :bio, rows: 3, class: "form-control", placeholder: "e.g. Solo hiker, loves historic architecture, photography enthusiast..." %>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <%= f.submit "Save Profile Preferences", class: "btn btn-primary" %>
        <%= link_to "Cancel", profile_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
