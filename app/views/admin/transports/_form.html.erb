<%= form_with model: [:admin, @transport], local: true do |f| %>
  <% if @transport.errors.any? %>
    <div class="flash flash-alert" style="margin-bottom: 1.5rem;">
      <ul>
        <% @transport.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :origin_city, "Origin City", class: "form-label" %>
      <%= f.text_field :origin_city, class: "form-control", placeholder: "e.g. London", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :destination_city, "Destination City", class: "form-label" %>
      <%= f.text_field :destination_city, class: "form-control", placeholder: "e.g. Paris", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :destination_id, "Linked Destination (optional)", class: "form-label" %>
      <%= f.collection_select :destination_id, @destinations, :id, :name, { include_blank: "None" }, class: "form-control" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :transport_type, "Type", class: "form-label" %>
      <%= f.select :transport_type, ["Flight", "Train", "Bus", "Car Rental", "Private Transfer"], {}, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :provider_name, "Carrier / Operator", class: "form-label" %>
      <%= f.text_field :provider_name, class: "form-control", placeholder: "e.g. Eurostar / Air France", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :fare_price, "Fare / Price ($)", class: "form-label" %>
      <%= f.number_field :fare_price, step: "0.01", class: "form-control", required: true %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :departure_time, "Departure Time", class: "form-label" %>
      <%= f.text_field :departure_time, class: "form-control", placeholder: "08:30 AM" %>
    </div>

    <div class="form-group">
      <%= f.label :arrival_time, "Arrival Time", class: "form-label" %>
      <%= f.text_field :arrival_time, class: "form-control", placeholder: "11:45 AM" %>
    </div>

    <div class="form-group">
      <%= f.label :duration_minutes, "Duration (Minutes)", class: "form-label" %>
      <%= f.number_field :duration_minutes, min: 1, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :comfort_class, "Class", class: "form-label" %>
      <%= f.select :comfort_class, ["Standard", "Economy", "Business", "First Class"], {}, class: "form-control" %>
    </div>
  </div>

  <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
    <%= f.submit "Save Transport Route", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_transports_path, class: "btn btn-secondary" %>
  </div>
<% end %>
