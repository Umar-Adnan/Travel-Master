<%= form_with model: [:admin, @route], local: true do |f| %>
  <% if @route.errors.any? %>
    <div class="flash flash-alert" style="margin-bottom: 1.5rem;">
      <ul>
        <% @route.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :route_name, "Route Name", class: "form-label" %>
    <%= f.text_field :route_name, class: "form-control", placeholder: "e.g. Karakoram Highway Express Corridor", required: true %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :origin_city, "Origin City", class: "form-label" %>
      <%= f.text_field :origin_city, class: "form-control", placeholder: "e.g. Islamabad", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :destination_city, "Destination City", class: "form-label" %>
      <%= f.text_field :destination_city, class: "form-control", placeholder: "e.g. Hunza", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :destination_id, "Destination (optional)", class: "form-label" %>
      <%= f.collection_select :destination_id, @destinations, :id, :name, { include_blank: "None" }, class: "form-control" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :distance_km, "Distance (km)", class: "form-label" %>
      <%= f.number_field :distance_km, step: "0.1", class: "form-control", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :estimated_drive_time_hours, "Drive Time (Hours)", class: "form-label" %>
      <%= f.number_field :estimated_drive_time_hours, step: "0.1", class: "form-control", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :road_condition, "Road Condition", class: "form-label" %>
      <%= f.select :road_condition, ["Excellent", "Good", "Moderate", "Under Maintenance"], {}, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :toll_charges, "Tolls ($)", class: "form-label" %>
      <%= f.number_field :toll_charges, step: "0.01", class: "form-control" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :route_highlights, "Road & Route Highlights", class: "form-label" %>
    <%= f.text_area :route_highlights, rows: 3, class: "form-control" %>
  </div>

  <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
    <%= f.submit "Save Route Segment", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_routes_infos_path, class: "btn btn-secondary" %>
  </div>
<% end %>
