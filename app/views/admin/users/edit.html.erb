<% content_for :title, "Edit User - #{@user.name}" %>

<div class="card" style="padding: 2rem; max-width: 700px;">
  <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">Edit User Account</h1>

  <%= form_with model: [:admin, @user], local: true do |f| %>
    <div class="form-group">
      <%= f.label :name, "User Name", class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :email, "Email Address", class: "form-label" %>
      <%= f.email_field :email, class: "form-control", required: true %>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="form-group">
        <%= f.label :role, "System Role", class: "form-label" %>
        <%= f.select :role, [["Standard User", "user"], ["Administrator", "admin"]], {}, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :travel_preference, "Travel Style", class: "form-label" %>
        <%= f.select :travel_preference, ["budget", "moderate", "luxury"], {}, class: "form-control" %>
      </div>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <%= f.submit "Update User", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_users_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
