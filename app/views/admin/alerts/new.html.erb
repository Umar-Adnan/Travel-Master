<% content_for :title, "Broadcast Alert - Admin" %>

<div class="card" style="padding: 2rem; max-width: 700px;">
  <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">📢 Broadcast New System Alert</h1>

  <%= form_with model: [:admin, @alert], local: true do |f| %>
    <% if @alert.errors.any? %>
      <div class="flash flash-alert" style="margin-bottom: 1.5rem;">
        <ul>
          <% @alert.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="form-group">
        <%= f.label :alert_type, "Alert Category", class: "form-label" %>
        <%= f.select :alert_type, ["Weather", "Safety", "Travel Advisory", "Route Closure", "System"], {}, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :severity, "Severity Level", class: "form-label" %>
        <%= f.select :severity, [["Info", "info"], ["Warning", "warning"], ["Critical", "critical"]], {}, class: "form-control" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :title, "Alert Title", class: "form-label" %>
      <%= f.text_field :title, class: "form-control", placeholder: "e.g. Monsoon Warning – Bali Region", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :message, "Full Alert Message", class: "form-label" %>
      <%= f.text_area :message, rows: 4, class: "form-control", placeholder: "Describe the situation clearly for travelers...", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :destination_id, "Linked Destination (optional – leave blank for global)", class: "form-label" %>
      <%= f.collection_select :destination_id, @destinations, :id, :name, { include_blank: "🌐 All Destinations (Global)" }, class: "form-control" %>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <%= f.submit "Broadcast Alert", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_alerts_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
