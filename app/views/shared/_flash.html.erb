<% if notice.present? || alert.present? %>
  <div class="flash-container">
    <% if notice %>
      <div class="flash flash-notice">
        <span>✅ <%= notice %></span>
      </div>
    <% end %>
    <% if alert %>
      <div class="flash flash-alert">
        <span>⚠️ <%= alert %></span>
      </div>
    <% end %>
  </div>
<% end %>
