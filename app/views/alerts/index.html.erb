<% content_for :title, "Notifications & Alerts - TravelMaster" %>

<div class="container-sm">
  <div class="section-header">
    <div>
      <h1 class="section-title">🔔 Safety, Weather & Travel Alerts</h1>
      <p class="section-subtitle">Real-time hazard notifications, weather changes, and booking alerts</p>
    </div>

    <% if @unread_count > 0 %>
      <%= button_to "Mark All as Read", mark_all_read_alerts_path, method: :post, class: "btn btn-outline btn-sm" %>
    <% end %>
  </div>

  <% if @alerts.any? %>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <% @alerts.each do |alert| %>
        <div class="card" style="padding: 1.25rem; border-left: 5px solid <%= alert.severity == 'warning' ? '#f59e0b' : (alert.severity == 'critical' ? '#ef4444' : '#3b82f6') %>; opacity: <%= alert.is_read? ? '0.75' : '1.0' %>;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="font-size: 1.3rem;"><%= alert.type_icon %></span>
              <strong style="font-size: 1.05rem;"><%= alert.title %></strong>
              <% unless alert.is_read? %>
                <span class="badge badge-primary" style="font-size: 0.7rem;">NEW</span>
              <% end %>
            </div>

            <span class="badge badge-<%= alert.severity == 'warning' ? 'warning' : 'primary' %>"><%= alert.severity.upcase %></span>
          </div>

          <p style="font-size: 0.9rem; color: #334155; line-height: 1.5; margin-bottom: 0.75rem;">
            <%= alert.message %>
          </p>

          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--text-muted); padding-top: 0.5rem; border-top: 1px solid var(--border-light);">
            <span>Posted <%= time_ago_in_words(alert.created_at) %> ago</span>

            <div style="display: flex; gap: 0.5rem;">
              <% unless alert.is_read? %>
                <%= button_to "Mark as Read", alert_path(alert), method: :patch, class: "btn btn-outline btn-sm", style: "font-size: 0.75rem; padding: 2px 8px;" %>
              <% end %>
              <%= button_to "Dismiss", alert_path(alert), method: :delete, class: "btn btn-outline btn-sm", style: "font-size: 0.75rem; padding: 2px 8px; color: var(--danger);" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card" style="padding: 3rem; text-align: center;">
      <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">✨</div>
      <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 0.5rem;">All clear!</h2>
      <p style="color: var(--text-muted);">No active travel warnings or pending notifications at this time.</p>
    </div>
  <% end %>
</div>
